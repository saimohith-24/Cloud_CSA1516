rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default fallback: deny unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Sensor Readings Collection (Used by Predictive Maintenance Demo)
    match /sensor_readings/{readingId} {
      allow read, write: if true;
    }

    // User Collection: Allow authenticated users to manage their own profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Messages Collection: Allow authenticated users to read and create messages
    match /messages/{messageId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
  }
}
